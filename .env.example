# Netlify Database supplies NETLIFY_DB_URL after database initialization.
NETLIFY_DB_URL=

# Admin portal. Generate the hash with `npm run admin:hash` and its hidden prompt.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD_HASH=scrypt$replace-with-generated-value
SESSION_SECRET=

# Server-side Resend verification. Use a separate, sending-only key for
# every client/environment and a From address on that client's verified domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Revive Co <notifications@your-verified-domain.com>
RESEND_REPLY_TO_EMAIL=owner@example.com
RESEND_TEST_TO_EMAIL=delivered@resend.dev
