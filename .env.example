# Netlify Database supplies NETLIFY_DB_URL after database initialization.
NETLIFY_DB_URL=

# Admin portal. Generate the hash with: npm run admin:hash -- "your strong password"
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD_HASH=scrypt$replace-with-generated-value
SESSION_SECRET=replace-with-at-least-32-random-characters

# Service-request email notifications through Resend.
RESEND_API_KEY=re_replace_me
CONTACT_FROM_EMAIL=Revive Co Website <requests@your-verified-domain.com>
CONTACT_NOTIFICATION_EMAIL=owner@example.com

# Stripe Checkout and verified webhook signing.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
