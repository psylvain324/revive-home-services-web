{
  "name": "revive-home-services-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:netlify": "vite --host 0.0.0.0 --mode netlify",
    "build": "tsc --noEmit && vite build && node scripts/prerender-routes.mjs",
    "build:netlify": "npm run lint && npm test",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint src netlify/functions lib scripts tests",
    "check": "tsc --noEmit",
    "test": "npm run build && node --no-warnings --experimental-strip-types --test tests/*.test.mjs",
    "audit:site": "npm run lint && npm test && npm audit --audit-level=high",
    "audit:deploy": "npm run audit:site && npm run email:check",
    "admin:hash": "node scripts/hash-admin-password.mjs",
    "email:check": "node --env-file-if-exists=.env.resend.local scripts/test-resend.mjs",
    "email:test": "node --env-file-if-exists=.env.resend.local scripts/test-resend.mjs --send"
  },
  "dependencies": {
    "@netlify/database": "^2.0.1",
    "@netlify/functions": "^6.0.0",
    "iframe-resizer": "4.3.11",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "^8.3.5"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
