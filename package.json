{
  "name": "revive-home-services-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:netlify": "vite --host 0.0.0.0 --mode netlify",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint src netlify/functions",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test tests/site.test.mjs",
    "audit:site": "npm run lint && npm test && npm audit --audit-level=high",
    "admin:hash": "node scripts/hash-admin-password.mjs"
  },
  "dependencies": {
    "@netlify/database": "^2.0.1",
    "@netlify/functions": "^6.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "stripe": "^22.6.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.2.2"
  }
}
